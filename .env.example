# RPi Door Access API Configuration - EXAMPLE FILE
# Copy this file to .env and change the values.

# Admin credentials
SUPER_USER=admin
SUPER_PASSWORD=placeholder_password

# Secret Key for JWT Generation (used for sessions/API authentication)
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never keep this placeholder: this file is public, and anyone who knows the
# key can forge an admin session.
JWT_SECRET_KEY=placeholder_secret_key

# Print RFID polling and swipe details to the service log
VERBOSE=false

# Optional overrides (defaults shown, see app/core/config.py)
# DATABASE_URL=sqlite:///./rpi_door_access.db
# RELAY_PIN=17
# BUZZER_PIN=22
# LED_GREEN_PIN=27
# LED_RED_PIN=18
# RFID_RST_PIN=25
